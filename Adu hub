-- --- PART 5: ESP ENGINE & ANTI-LAG ---
local function CreateESP(object, name, color)
    if object:FindFirstChild("MaruESP") then return end
    
    local highlight = Instance.new("Highlight")
    highlight.Name = "MaruESP"
    highlight.FillColor = color
    highlight.FillTransparency = 0.5
    highlight.OutlineColor = Color3.fromRGB(255, 255, 255)
    highlight.Parent = object

    local billboard = Instance.new("BillboardGui")
    billboard.Name = "MaruESP_Label"
    billboard.Size = UDim2.new(0, 100, 0, 40)
    billboard.AlwaysOnTop = true
    billboard.StudsOffset = Vector3.new(0, 3, 0)
    billboard.Parent = object

    local textLabel = Instance.new("TextLabel")
    textLabel.Size = UDim2.new(1, 0, 1, 0)
    textLabel.BackgroundTransparency = 1
    textLabel.TextColor3 = color
    textLabel.TextScaled = true
    textLabel.Font = Enum.Font.SourceSansBold
    textLabel.Text = name
    textLabel.Parent = billboard

    task.spawn(function()
        while object and object.Parent do
            local player = game.Players.LocalPlayer
            if player.Character and player.Character:FindFirstChild("HumanoidRootPart") then
                local distance = math.floor((object.Position - player.Character.HumanoidRootPart.Position).Magnitude)
                textLabel.Text = name .. " [" .. tostring(distance) .. "m]"
            end
            task.wait(0.5)
        end
    end)
end

